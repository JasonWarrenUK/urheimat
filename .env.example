MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=urheimat

# Auth.js. Leave these unset to play anonymously: the game still runs, and the
# sign-in control stays hidden.
# AUTH_SECRET: generate with `openssl rand -hex 32`
AUTH_SECRET=
# From the GitHub OAuth app (see docs/setup/github-oauth.md)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
